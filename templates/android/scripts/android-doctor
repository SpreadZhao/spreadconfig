#!/usr/bin/env bash
set -euo pipefail

android_home="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-${XDG_LIB_HOME:-$HOME/Lib}/Android/Sdk}}"
adb_bin="$android_home/platform-tools/adb"

echo "ANDROID_HOME=$android_home"

if [[ ! -d "$android_home" ]]; then
  echo "Android SDK directory is missing." >&2
  exit 1
fi

if [[ ! -x "$adb_bin" ]]; then
  echo "adb is missing or not executable: $adb_bin" >&2
  exit 1
fi

"$adb_bin" version
"$adb_bin" devices
if command -v android >/dev/null 2>&1; then
  android --version
else
  echo "android-cli is not available in this environment; SDK and Gradle checks continue." >&2
fi

if [[ -x ./gradlew ]]; then
  ./gradlew --version
else
  gradle --version
fi
