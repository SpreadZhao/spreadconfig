#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: resolve-nix-script [--repo REPO_ROOT] [--host HOST] [SCRIPT_NAME]

Print the repo-local nix helper script for HOST.
Defaults:
  SCRIPT_NAME       sns_until
  HOST             $SPREADCONFIG_HOST, then hostname -s
  REPO_ROOT        $SPREADCONFIG_REPO, then local checkout discovery

Script location:
  modules/home/nix-tools/scripts/nix/SCRIPT_NAME
HOST is validated against hosts/HOST/host.nix.
EOF
}

find_repo_root() {
  local git_root dir start
  if git_root="$(git rev-parse --show-toplevel 2>/dev/null)" &&
    [[ -f "$git_root/flake.nix" && -d "$git_root/hosts" ]]; then
    printf '%s\n' "$git_root"
    return
  fi

  for start in "$PWD" "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"; do
    dir="$start"
    while true; do
      if [[ -f "$dir/flake.nix" && -d "$dir/hosts" ]]; then
        printf '%s\n' "$dir"
        return
      fi
      [[ "$dir" != / ]] || break
      dir="$(dirname "$dir")"
    done
  done

  echo "resolve-nix-script: could not find spreadconfig repo root" >&2
  exit 1
}

repo_root="${SPREADCONFIG_REPO:-}"
host="${SPREADCONFIG_HOST:-}"
script_name="sns_until"

while (($#)); do
  case "$1" in
    --repo)
      [[ $# -ge 2 ]] || {
        usage
        exit 2
      }
      repo_root="$2"
      shift 2
      ;;
    --host)
      [[ $# -ge 2 ]] || {
        usage
        exit 2
      }
      host="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "resolve-nix-script: unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      script_name="$1"
      shift
      ;;
  esac
done

repo_root="${repo_root:-$(find_repo_root)}"

if [[ -z "$host" ]]; then
  host="$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)"
  host="${host%%.*}"
fi

if [[ ! "$host" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] ||
  [[ ! -f "$repo_root/hosts/$host/host.nix" ]]; then
  echo "resolve-nix-script: unknown host '$host'" >&2
  echo "Available hosts:" >&2
  for declaration in "$repo_root"/hosts/*/host.nix; do
    [[ -f "$declaration" ]] || continue
    host_dir="${declaration%/host.nix}"
    printf '  %s\n' "${host_dir##*/}"
  done | sort >&2
  exit 1
fi

if [[ ! "$script_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
  echo "resolve-nix-script: invalid script name '$script_name'" >&2
  exit 1
fi

script="$repo_root/modules/home/nix-tools/scripts/nix/$script_name"

if [[ -f "$script" ]]; then
  printf '%s\n' "$script"
else
  echo "resolve-nix-script: script '$script_name' not found for host '$host'" >&2
  exit 1
fi
