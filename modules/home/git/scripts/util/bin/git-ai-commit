#!/usr/bin/env bash

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
# shellcheck source=modules/home/git/scripts/util/lib/git-ai.sh
source "$SCRIPT_DIR/../lib/git-ai.sh"

TMP_FILE=$(mktemp)
LOG_FILE=$(mktemp)
CONTEXT_FILE=$(mktemp)
FULL_DIFF_FILE=$(mktemp)
trap 'rm -f "$TMP_FILE" "$LOG_FILE" "$CONTEXT_FILE" "$FULL_DIFF_FILE"' EXIT

MAX_FULL_CONTEXT_BYTES="${GIT_AI_MAX_FULL_CONTEXT_BYTES:-200000}"
MAX_COMPACT_DIFF_LINES="${GIT_AI_MAX_COMPACT_DIFF_LINES:-900}"
MAX_COMPACT_FILE_DIFF_LINES="${GIT_AI_MAX_COMPACT_FILE_DIFF_LINES:-120}"

PROMPT=$(
    cat <<'EOF'
Write a commit message for the staged changes only. Do not stage files or commit.
Use the supplied summary, status and diff; large diffs may contain only excerpts.
Do not invent changes missing from that context.

Return only an English commit message, without commentary or Markdown fences.
Use type(scope): title, or type: title when no scope helps. Allowed types:
feat, fix, chore, docs, refactor, test, style, perf.

Keep the title lowercase, specific, at most 50 characters, with no final period.
Add an optional body only to explain the reason or a consequence. Use concise
bullets when several points are needed. Avoid vague titles and file-by-file lists.

Example:
fix(auth): reject expired tokens

- Prevent expired sessions from reaching protected routes.
EOF
)

file_size_bytes() {
    wc -c <"$1" | tr -d ' '
}

write_compact_diff() {
    local diff_file="$1"

    awk \
        -v max_total="$MAX_COMPACT_DIFF_LINES" \
        -v max_file="$MAX_COMPACT_FILE_DIFF_LINES" '
        BEGIN {
            total = 0
            file_lines = 0
            omitted_file = 0
            omitted_all = 0
        }

        /^diff --git / {
            if (omitted_file && total < max_total) {
                print "[... omitted additional lines for previous file ...]"
                total++
            }
            file_lines = 0
            omitted_file = 0
        }

        {
            if (total >= max_total) {
                if (!omitted_all) {
                    print "[... omitted remaining diff because context is large ...]"
                    omitted_all = 1
                }
                next
            }

            is_header = ($0 ~ /^diff --git / || $0 ~ /^index / || $0 ~ /^(---|\+\+\+) / || $0 ~ /^@@ /)

            if (is_header || file_lines < max_file) {
                print
                total++
                file_lines++
                next
            }

            if (!omitted_file) {
                print "[... omitted additional lines for this file ...]"
                total++
                omitted_file = 1
            }
        }
    ' "$diff_file"
}

build_context() {
    local diff_size

    git diff --staged --find-renames --find-copies >"$FULL_DIFF_FILE"
    diff_size=$(file_size_bytes "$FULL_DIFF_FILE")

    {
        echo "# Staged change context"
        echo
        echo "## Staged file summary"
        git diff --staged --stat --find-renames --find-copies
        echo
        echo "## Staged name status"
        git diff --staged --name-status --find-renames --find-copies
        echo

        if ((diff_size <= MAX_FULL_CONTEXT_BYTES)); then
            echo "## Full staged diff"
            cat "$FULL_DIFF_FILE"
        else
            echo "## Compact staged diff"
            echo "Full staged diff is ${diff_size} bytes, over the ${MAX_FULL_CONTEXT_BYTES} byte limit."
            echo "Use this compact context to generate a high-level commit message."
            echo
            write_compact_diff "$FULL_DIFF_FILE"
        fi
    } >"$CONTEXT_FILE"

    if ((diff_size > MAX_FULL_CONTEXT_BYTES)); then
        echo "==> Staged diff is large; using compact context (${diff_size} bytes)"
    fi
}

if git diff --staged --quiet; then
    echo "No staged changes to commit."
    exit 1
fi

echo "==> Reading staged changes"
build_context
echo "==> Generating commit message with $(git_ai_backend_description)"

if ! git_ai_run "$PROMPT" "$CONTEXT_FILE" "$TMP_FILE" "$LOG_FILE"; then
    echo "$(git_ai_backend_description) failed while generating the commit message:" >&2
    cat "$LOG_FILE" >&2
    exit 1
fi

if [[ ! -s "$TMP_FILE" ]]; then
    echo "$(git_ai_backend_description) did not produce a commit message." >&2
    cat "$LOG_FILE" >&2
    exit 1
fi

echo "==> Opening git commit editor"
git commit -e -F "$TMP_FILE"
