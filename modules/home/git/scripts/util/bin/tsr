#!/bin/bash

# Toggle the SecondBrain origin between NAS and GitHub.
REMOTE_NAS="ssh://gitter@spreadzhao.cloud:10112/volume1/repositories/SecondBrain"
REMOTE_GITHUB="https://github.com/SpreadZhao/SecondBrain.git"
REMOTE_NAME="origin"

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "Not inside a Git repository."
    exit 1
fi

CURRENT_URL=$(git remote get-url $REMOTE_NAME 2>/dev/null)
if [ -z "$CURRENT_URL" ]; then
    echo "Could not read remote '$REMOTE_NAME'."
    exit 1
fi

if [ "$CURRENT_URL" = "$REMOTE_NAS" ]; then
    git remote set-url $REMOTE_NAME $REMOTE_GITHUB
    echo "Using GitHub:"
    echo "   $REMOTE_GITHUB"
elif [ "$CURRENT_URL" = "$REMOTE_GITHUB" ]; then
    git remote set-url $REMOTE_NAME $REMOTE_NAS
    echo "Using NAS:"
    echo "   $REMOTE_NAS"
else
    echo "Remote URL does not match NAS or GitHub:"
    echo "   $CURRENT_URL"
    read -p "Set the remote to NAS? (y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        git remote set-url $REMOTE_NAME $REMOTE_NAS
        echo "Using NAS:"
        echo "   $REMOTE_NAS"
    else
        echo "Cancelled; remote unchanged."
        exit 0
    fi
fi

FINAL_URL=$(git remote get-url $REMOTE_NAME)
echo "Remote '$REMOTE_NAME':"
echo "   $FINAL_URL"
