#!/usr/bin/env bash

set -euo pipefail

run_default() {
    exec "$SCRIPT_HOME/niri/launcher_kitty.sh" "$@"
}

run_dmenu() {
    exec "$SCRIPT_HOME/niri/fzf_dmenu_kitty.sh" "$@"
}

case "${1-}" in
    --dmenu)
        shift
        run_dmenu "$@"
        ;;
    "" )
        run_default "$@"
        ;;
    * )
        echo "Unknown option: $1" >&2
        echo "Usage: fm-kitty [--dmenu]" >&2
        exit 1
        ;;
esac
