#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: resolve-nix-script [--repo REPO_ROOT] [--host HOST] [SCRIPT_NAME]

Print the repo-local nix helper script for HOST.
Defaults:
  SCRIPT_NAME       sns_until
  HOST             $SPREADCONFIG_HOST, then hostname -s

Lookup order:
  spreadconfig/scripts/HOST/nix/SCRIPT_NAME
  spreadconfig/scripts/default/nix/SCRIPT_NAME
EOF
}

find_repo_root() {
  if git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    printf '%s\n' "$git_root"
    return
  fi

  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/flake.nix" && -d "$dir/spreadconfig/scripts" && -d "$dir/hosts" ]]; then
      printf '%s\n' "$dir"
      return
    fi
    dir="$(dirname "$dir")"
  done

  echo "resolve-nix-script: could not find spreadconfig repo root" >&2
  exit 1
}

repo_root=""
host="${SPREADCONFIG_HOST:-}"
script_name="sns_until"

while (($#)); do
  case "$1" in
    --repo)
      [[ $# -ge 2 ]] || {
        usage
        exit 2
      }
      repo_root="$2"
      shift 2
      ;;
    --host)
      [[ $# -ge 2 ]] || {
        usage
        exit 2
      }
      host="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "resolve-nix-script: unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      script_name="$1"
      shift
      ;;
  esac
done

repo_root="${repo_root:-$(find_repo_root)}"

if [[ -z "$host" ]]; then
  host="$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)"
  host="${host%%.*}"
fi

if [[ -z "$host" || ! -d "$repo_root/hosts/$host" ]]; then
  echo "resolve-nix-script: unknown host '$host'" >&2
  echo "Available hosts:" >&2
  find "$repo_root/hosts" -mindepth 1 -maxdepth 1 -type d -printf '  %f\n' | sort >&2
  exit 1
fi

host_script="$repo_root/spreadconfig/scripts/$host/nix/$script_name"
default_script="$repo_root/spreadconfig/scripts/default/nix/$script_name"

if [[ -f "$host_script" ]]; then
  printf '%s\n' "$host_script"
elif [[ -f "$default_script" ]]; then
  printf '%s\n' "$default_script"
else
  echo "resolve-nix-script: script '$script_name' not found for host '$host' or default" >&2
  exit 1
fi
