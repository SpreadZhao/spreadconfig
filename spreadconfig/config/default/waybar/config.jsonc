// Shared bar; machine-specific battery and sensor modules belong in config/<host>.
{
    "height": 30,
    "spacing": 0,
    "modules-left": [
        "group/niri-workspace-window",
        "custom/screen-record-time"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "group/usage",
        "network",
        "group/audio",
        "custom/time",
        "tray"
    ],
    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 0,
            "click-to-reveal": true
        },
        "modules": [
            "custom/sink",
            "custom/source"
        ]
    },
    "group/usage": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 0,
            "click-to-reveal": true
        },
        "modules": [
            "cpu",
            "memory"
        ]
    },
    "group/niri-workspace-window": {
        "orientation": "horizontal",
        "modules": [
            "niri/workspaces",
            "custom/window-indicator"
        ]
    },
    "custom/spacer": {
        "format": "|"
    },
    "custom/window-indicator": {
        "format": "{}",
        "exec": "/home/spreadzhao/scripts/niri/niri_windows.sh",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true
    },
    "niri/window": {
        "format": "{}",
        "hide-empty-text": true,
        "separate-outputs": true
    },
    "custom/screen-record-time": {
        "format": "  {}",
        "exec": "/home/spreadzhao/scripts/util/get_screenrecord_time.sh",
        "interval": 1,
        "hide-empty-text": true
    },
    "custom/info": {
        "exec": "/home/spreadzhao/scripts/util/round_info.sh",
        "interval": 10
    },
    "custom/sink": {
        "exec": "/home/spreadzhao/scripts/niri/sink_niri.sh",
        "interval": 10,
        "signal": 7
    },
    "custom/source": {
        "exec": "/home/spreadzhao/scripts/niri/source_niri.sh",
        "interval": 10,
        "signal": 7
    },
    "custom/time": {
        "exec": "/home/spreadzhao/scripts/util/get_time.sh",
        "interval": 31,
        "on-click": "exec /home/spreadzhao/scripts/util/toggle_time_format.sh",
        "signal": 9,
        "tooltip": false
    },
    "tray": {
        "format": "{}",
        "icon-size": 25,
        "spacing": 0
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M %a}|",
        "format-alt": "{:%H:%M}|"
    },
    "cpu": {
        "interval": 10,
        "format": "{usage}"
    },
    "memory": {
        "interval": 10,
        "format": "{percentage}"
    },
    "wireplumber": {
        "format": "{volume}%{icon}|",
        "format-muted": "",
        "on-click": "helvum",
        "max-volume": 150,
        "scroll-step": 5,
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰯡",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} 󰈀",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    }
}
