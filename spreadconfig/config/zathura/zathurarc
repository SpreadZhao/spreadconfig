# Default colors
set default-fg                rgba(212,212,212,1)
set default-bg                rgba(0,0,0,1)

# Completion
set completion-bg             rgba(38,38,38,1)
set completion-fg             rgba(212,212,212,1)
set completion-highlight-bg   rgba(71,162,237,1)
set completion-highlight-fg   rgba(0,0,0,1)
set completion-group-bg       rgba(0,0,0,1)
set completion-group-fg       rgba(230,230,170,1)

# Status / Input
set statusbar-fg              rgba(212,212,212,1)
set statusbar-bg              rgba(0,0,0,1)
set inputbar-fg               rgba(212,212,212,1)
set inputbar-bg               rgba(38,38,38,1)

# Notifications
set notification-bg           rgba(38,38,38,1)
set notification-fg           rgba(212,212,212,1)
set notification-error-bg     rgba(38,38,38,1)
set notification-error-fg     rgba(255,0,0,1)
set notification-warning-bg   rgba(38,38,38,1)
set notification-warning-fg   rgba(255,198,109,1)

# Index
set index-fg                  rgba(212,212,212,1)
set index-bg                  rgba(0,0,0,1)
set index-active-fg           rgba(212,212,212,1)
set index-active-bg           rgba(58,58,58,1)

# Rendering
set render-loading-bg         rgba(0,0,0,1)
set render-loading-fg         rgba(212,212,212,1)

# Highlights
set highlight-color           rgba(71,162,237,0.3)
set highlight-fg              rgba(212,212,212,1)
set highlight-active-color    rgba(255,198,109,0.3)

set adjust-open	"best-fit"
set font	"IBM Plex Sans 20"
set pages-per-row	"1"
set scroll-page-aware	"true"
