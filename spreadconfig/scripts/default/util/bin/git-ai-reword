#!/usr/bin/env bash

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
# shellcheck source=spreadconfig/scripts/default/util/lib/git-ai.sh
source "$SCRIPT_DIR/../lib/git-ai.sh"

TARGET_REV="${1:-HEAD}"
TMP_FILE=$(mktemp)
LOG_FILE=$(mktemp)
CONTEXT_FILE=$(mktemp)
FULL_DIFF_FILE=$(mktemp)
SEQUENCE_EDITOR=$(mktemp)
MESSAGE_EDITOR=$(mktemp)
trap 'rm -f "$TMP_FILE" "$LOG_FILE" "$CONTEXT_FILE" "$FULL_DIFF_FILE" "$SEQUENCE_EDITOR" "$MESSAGE_EDITOR"' EXIT

MAX_FULL_CONTEXT_BYTES="${GIT_AI_MAX_FULL_CONTEXT_BYTES:-200000}"
MAX_COMPACT_DIFF_LINES="${GIT_AI_MAX_COMPACT_DIFF_LINES:-900}"
MAX_COMPACT_FILE_DIFF_LINES="${GIT_AI_MAX_COMPACT_FILE_DIFF_LINES:-120}"

PROMPT=$(
    cat <<'EOF'
Your task is to generate a replacement commit message for one existing commit.

The input may be either the full commit diff or a compact context generated from
a large commit. When the input is compact, use the metadata, file summary, name
status, and diff excerpts to infer the intent. Do not invent changes that are
not supported by the provided context.

## Guidelines

- Use only the provided commit metadata and diff.
- Preserve the intent of the commit.
- Improve clarity and specificity.
- Do not invent changes that are not present in the diff.
- Only generate text as described in `Example`, no other redundant words (including markdown symbols like ```).
- Follow the rules below for the commit message.

## Format

<type>:<space><message title>

<bullet points summarizing what was updated>

## Example Titles

feat(auth): add JWT login flow
fix(ui): handle null pointer in sidebar
refactor(api): split user controller logic
docs(readme): add usage section

## Example with Title and Body

feat(auth): add JWT login flow

- Implemented JWT token validation logic
- Added documentation for the validation component

## Rules

* title is lowercase, no period at the end.
* Title should be a clear summary, max 50 characters.
* Use the body (optional) to explain *why*, not just *what*.
* Bullet points should be concise and high-level.

Avoid

* Vague titles like: "update", "fix stuff"
* Overly long or unfocused titles
* Excessive detail in bullet points

## Allowed Types

| Type     | Description                           |
| -------- | ------------------------------------- |
| feat     | New feature                           |
| fix      | Bug fix                               |
| chore    | Maintenance (e.g., tooling, deps)     |
| docs     | Documentation changes                 |
| refactor | Code restructure (no behavior change) |
| test     | Adding or refactoring tests           |
| style    | Code formatting (no logic change)     |
| perf     | Performance improvements              |
EOF
)

usage() {
    echo "Usage: git-ai-reword [commit]"
}

file_size_bytes() {
    wc -c <"$1" | tr -d ' '
}

write_compact_diff() {
    local diff_file="$1"

    awk \
        -v max_total="$MAX_COMPACT_DIFF_LINES" \
        -v max_file="$MAX_COMPACT_FILE_DIFF_LINES" '
        BEGIN {
            total = 0
            file_lines = 0
            omitted_file = 0
            omitted_all = 0
        }

        /^diff --git / {
            if (omitted_file && total < max_total) {
                print "[... omitted additional lines for previous file ...]"
                total++
            }
            file_lines = 0
            omitted_file = 0
        }

        {
            if (total >= max_total) {
                if (!omitted_all) {
                    print "[... omitted remaining diff because context is large ...]"
                    omitted_all = 1
                }
                next
            }

            is_header = ($0 ~ /^diff --git / || $0 ~ /^index / || $0 ~ /^(---|\+\+\+) / || $0 ~ /^@@ /)

            if (is_header || file_lines < max_file) {
                print
                total++
                file_lines++
                next
            }

            if (!omitted_file) {
                print "[... omitted additional lines for this file ...]"
                total++
                omitted_file = 1
            }
        }
    ' "$diff_file"
}

build_context() {
    local target_commit="$1"
    local diff_size

    git show --format= --patch --find-renames --find-copies "$target_commit" >"$FULL_DIFF_FILE"
    diff_size=$(file_size_bytes "$FULL_DIFF_FILE")

    {
        echo "# Commit context"
        echo
        echo "## Commit metadata and existing message"
        git show -s --format=fuller "$target_commit"
        echo
        echo "## Changed file summary"
        git show --format= --stat --find-renames --find-copies "$target_commit"
        echo
        echo "## Changed file name status"
        git show --format= --name-status --find-renames --find-copies "$target_commit"
        echo

        if ((diff_size <= MAX_FULL_CONTEXT_BYTES)); then
            echo "## Full commit diff"
            cat "$FULL_DIFF_FILE"
        else
            echo "## Compact commit diff"
            echo "Full commit diff is ${diff_size} bytes, over the ${MAX_FULL_CONTEXT_BYTES} byte limit."
            echo "Use this compact context to generate a high-level replacement commit message."
            echo
            write_compact_diff "$FULL_DIFF_FILE"
        fi
    } >"$CONTEXT_FILE"

    if ((diff_size > MAX_FULL_CONTEXT_BYTES)); then
        echo "==> Commit diff is large; using compact context (${diff_size} bytes)"
    fi
}

if [[ "${TARGET_REV}" == "-h" || "${TARGET_REV}" == "--help" ]]; then
    usage
    exit 0
fi

if ! TARGET_COMMIT=$(git rev-parse --verify "${TARGET_REV}^{commit}" 2>/dev/null); then
    echo "Commit not found: $TARGET_REV" >&2
    usage >&2
    exit 1
fi

HEAD_COMMIT=$(git rev-parse --verify HEAD)
SHORT_COMMIT=$(git rev-parse --short "$TARGET_COMMIT")
PARENT_COUNT=$(git show -s --format=%P "$TARGET_COMMIT" | wc -w | tr -d ' ')

if [[ "$PARENT_COUNT" -ne 1 ]]; then
    echo "Only non-root, non-merge commits are supported." >&2
    exit 1
fi

if ! git merge-base --is-ancestor "$TARGET_COMMIT" HEAD; then
    echo "Commit is not an ancestor of HEAD: $SHORT_COMMIT" >&2
    exit 1
fi

if [[ "$TARGET_COMMIT" != "$HEAD_COMMIT" ]]; then
    REBASE_MERGE=$(git rev-parse --git-path rebase-merge)
    REBASE_APPLY=$(git rev-parse --git-path rebase-apply)

    if [[ -d "$REBASE_MERGE" || -d "$REBASE_APPLY" ]]; then
        echo "A rebase is already in progress." >&2
        exit 1
    fi

    if ! git diff --quiet || ! git diff --cached --quiet; then
        echo "Rewording a non-HEAD commit requires no tracked working tree changes." >&2
        exit 1
    fi
fi

echo "==> Reading commit $SHORT_COMMIT"
build_context "$TARGET_COMMIT"
echo "==> Generating replacement commit message with $(git_ai_backend_description)"

if ! git_ai_run "$PROMPT" "$CONTEXT_FILE" "$TMP_FILE" "$LOG_FILE"; then
    echo "$(git_ai_backend_description) failed while generating the commit message:" >&2
    cat "$LOG_FILE" >&2
    exit 1
fi

if [[ ! -s "$TMP_FILE" ]]; then
    echo "$(git_ai_backend_description) did not produce a commit message." >&2
    cat "$LOG_FILE" >&2
    exit 1
fi

if [[ "$TARGET_COMMIT" == "$HEAD_COMMIT" ]]; then
    echo "==> Opening git commit editor"
    git commit --amend --only --allow-empty -e -F "$TMP_FILE"
    exit 0
fi

cat >"$SEQUENCE_EDITOR" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

TODO_FILE="$1"
TMP_TODO=$(mktemp)
FOUND=0

while IFS= read -r line; do
    if [[ "$line" == pick\ * ]]; then
        SHA_AND_REST=${line#pick }
        SHA=${SHA_AND_REST%% *}
        FULL_SHA=$(git rev-parse --verify "${SHA}^{commit}" 2>/dev/null || true)

        if [[ "$FULL_SHA" == "$AI_REWORD_TARGET" ]]; then
            printf 'reword %s\n' "$SHA_AND_REST" >>"$TMP_TODO"
            FOUND=1
            continue
        fi
    fi

    printf '%s\n' "$line" >>"$TMP_TODO"
done <"$TODO_FILE"

if [[ "$FOUND" -ne 1 ]]; then
    echo "Target commit was not found in the rebase todo." >&2
    rm -f "$TMP_TODO"
    exit 1
fi

mv "$TMP_TODO" "$TODO_FILE"
EOF

cat >"$MESSAGE_EDITOR" <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

MESSAGE_FILE="$1"
cp "$AI_REWORD_MESSAGE" "$MESSAGE_FILE"

if [[ -n "${AI_REWORD_REAL_EDITOR:-}" ]]; then
    editor_cmd="$AI_REWORD_REAL_EDITOR"
else
    editor_cmd="vi"
fi

eval "$editor_cmd \"\$MESSAGE_FILE\""
EOF

chmod +x "$SEQUENCE_EDITOR" "$MESSAGE_EDITOR"

BASE_COMMIT=$(git rev-parse "${TARGET_COMMIT}^")
REAL_EDITOR="${VISUAL:-${EDITOR:-}}"

echo "==> Opening git reword editor"
AI_REWORD_TARGET="$TARGET_COMMIT" \
    AI_REWORD_MESSAGE="$TMP_FILE" \
    AI_REWORD_REAL_EDITOR="$REAL_EDITOR" \
    GIT_SEQUENCE_EDITOR="$SEQUENCE_EDITOR" \
    GIT_EDITOR="$MESSAGE_EDITOR" \
    git rebase -i "$BASE_COMMIT"
