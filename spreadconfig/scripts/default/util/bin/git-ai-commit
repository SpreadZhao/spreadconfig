#!/usr/bin/env bash

set -euo pipefail

TMP_FILE=$(mktemp)
LOG_FILE=$(mktemp)
CONTEXT_FILE=$(mktemp)
FULL_DIFF_FILE=$(mktemp)
trap 'rm -f "$TMP_FILE" "$LOG_FILE" "$CONTEXT_FILE" "$FULL_DIFF_FILE"' EXIT

MAX_FULL_CONTEXT_BYTES="${GIT_AI_MAX_FULL_CONTEXT_BYTES:-200000}"
MAX_COMPACT_DIFF_LINES="${GIT_AI_MAX_COMPACT_DIFF_LINES:-900}"
MAX_COMPACT_FILE_DIFF_LINES="${GIT_AI_MAX_COMPACT_FILE_DIFF_LINES:-120}"

PROMPT=$(
    cat <<'EOF'
Your task is to generate a commit message for the staged changes.

The input may be either the full staged diff or a compact context generated from
large staged changes. When the input is compact, use the file summary, name
status, and diff excerpts to infer the intent. Do not invent changes that are
not supported by the provided context.

## Guidelines

- Only generate the message for staged files/changes
- Don't add any files using `git add`. The user will decide what to add. 
- Don't commit any files either. You can only generate commit messages.
- Only generate text as described in `Example`, no other redundant words (including markdown symbols like ```).
- Follow the rules below for the commit message.

## Format

<type>:<space><message title>

<bullet points summarizing what was updated>

## Example Titles

feat(auth): add JWT login flow
fix(ui): handle null pointer in sidebar
refactor(api): split user controller logic
docs(readme): add usage section

## Example with Title and Body

feat(auth): add JWT login flow

- Implemented JWT token validation logic
- Added documentation for the validation component

## Rules

* title is lowercase, no period at the end.
* Title should be a clear summary, max 50 characters.
* Use the body (optional) to explain *why*, not just *what*.
* Bullet points should be concise and high-level.

Avoid

* Vague titles like: "update", "fix stuff"
* Overly long or unfocused titles
* Excessive detail in bullet points

## Allowed Types

| Type     | Description                           |
| -------- | ------------------------------------- |
| feat     | New feature                           |
| fix      | Bug fix                               |
| chore    | Maintenance (e.g., tooling, deps)     |
| docs     | Documentation changes                 |
| refactor | Code restructure (no behavior change) |
| test     | Adding or refactoring tests           |
| style    | Code formatting (no logic change)     |
| perf     | Performance improvements              |
EOF
)

file_size_bytes() {
    wc -c <"$1" | tr -d ' '
}

write_compact_diff() {
    local diff_file="$1"

    awk \
        -v max_total="$MAX_COMPACT_DIFF_LINES" \
        -v max_file="$MAX_COMPACT_FILE_DIFF_LINES" '
        BEGIN {
            total = 0
            file_lines = 0
            omitted_file = 0
            omitted_all = 0
        }

        /^diff --git / {
            if (omitted_file && total < max_total) {
                print "[... omitted additional lines for previous file ...]"
                total++
            }
            file_lines = 0
            omitted_file = 0
        }

        {
            if (total >= max_total) {
                if (!omitted_all) {
                    print "[... omitted remaining diff because context is large ...]"
                    omitted_all = 1
                }
                next
            }

            is_header = ($0 ~ /^diff --git / || $0 ~ /^index / || $0 ~ /^(---|\+\+\+) / || $0 ~ /^@@ /)

            if (is_header || file_lines < max_file) {
                print
                total++
                file_lines++
                next
            }

            if (!omitted_file) {
                print "[... omitted additional lines for this file ...]"
                total++
                omitted_file = 1
            }
        }
    ' "$diff_file"
}

build_context() {
    local diff_size

    git diff --staged --find-renames --find-copies >"$FULL_DIFF_FILE"
    diff_size=$(file_size_bytes "$FULL_DIFF_FILE")

    {
        echo "# Staged change context"
        echo
        echo "## Staged file summary"
        git diff --staged --stat --find-renames --find-copies
        echo
        echo "## Staged name status"
        git diff --staged --name-status --find-renames --find-copies
        echo

        if ((diff_size <= MAX_FULL_CONTEXT_BYTES)); then
            echo "## Full staged diff"
            cat "$FULL_DIFF_FILE"
        else
            echo "## Compact staged diff"
            echo "Full staged diff is ${diff_size} bytes, over the ${MAX_FULL_CONTEXT_BYTES} byte limit."
            echo "Use this compact context to generate a high-level commit message."
            echo
            write_compact_diff "$FULL_DIFF_FILE"
        fi
    } >"$CONTEXT_FILE"

    if ((diff_size > MAX_FULL_CONTEXT_BYTES)); then
        echo "==> Staged diff is large; using compact context (${diff_size} bytes)"
    fi
}

if git diff --staged --quiet; then
    echo "No staged changes to commit."
    exit 1
fi

echo "==> Reading staged changes"
build_context
echo "==> Generating commit message with Codex (gpt-5.5, xhigh)"

if ! codex exec \
    --model gpt-5.5 \
    --config 'model_reasoning_effort="xhigh"' \
    --sandbox read-only \
    --ephemeral \
    --output-last-message "$TMP_FILE" \
    "$PROMPT" <"$CONTEXT_FILE" >"$LOG_FILE" 2>&1; then
    echo "Codex failed while generating the commit message:" >&2
    cat "$LOG_FILE" >&2
    exit 1
fi

if [[ ! -s "$TMP_FILE" ]]; then
    echo "Codex did not produce a commit message." >&2
    cat "$LOG_FILE" >&2
    exit 1
fi

echo "==> Opening git commit editor"
git commit -e -F "$TMP_FILE"
