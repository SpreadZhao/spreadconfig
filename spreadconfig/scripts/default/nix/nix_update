#!/usr/bin/env bash
set -Eeuo pipefail

nix_update_err() {
	local status=$?
	echo "nix_update: failed at line ${BASH_LINENO[0]}: $BASH_COMMAND (exit $status)" >&2
}

trap nix_update_err ERR

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
repo_dir="${SPREADCONFIG_REPO:-$(cd -- "$script_dir/../../../.." && pwd -P)}"
flake_url="path://$repo_dir"

action="boot"
action_set=0
list_inputs=0
use_exclude_file=1
exclude_file="$script_dir/nix_update.exclude"
exclude_file_explicit=0
max_attempts="${NIX_RETRY_ATTEMPTS:-5}"
retry_delay="${NIX_RETRY_DELAY:-2}"
flake_update_retry_patterns='Failed to fetch git repository|could not update local clone|unable to download|TLS connect error|Connection timed out|Timeout was reached|unexpected eof while reading|early EOF|HTTP/2 stream.*not closed cleanly'

declare -a cli_excludes=()
declare -a file_excludes=()

usage() {
	cat <<'EOF'
Usage: nix_update [switch|boot] [OPTIONS]

Update spreadconfig flake inputs and then run sns_until.

Options:
  -e, --exclude INPUT[,INPUT...]  Exclude one or more flake inputs for this run
      --exclude-file PATH        Read excluded inputs from PATH
      --no-exclude-file          Ignore the default exclude file
      --list-inputs              List current flake inputs and exit
  -h, --help                     Show this help

The default exclude file is nix_update.exclude next to this script.
It supports one input name per line, blank lines, and # comments.

Environment:
  NIX_RETRY_ATTEMPTS                 Outer flake update attempts, default 5
  NIX_RETRY_DELAY                    Initial retry delay in seconds, default 2
EOF
}

die() {
	echo "nix_update: $*" >&2
	exit 1
}

trim() {
	local value="$1"
	value="${value#"${value%%[![:space:]]*}"}"
	value="${value%"${value##*[![:space:]]}"}"
	printf '%s' "$value"
}

add_cli_excludes() {
	local csv="$1"
	local -a parts=()
	local part

	IFS=',' read -r -a parts <<<"$csv"
	for part in "${parts[@]}"; do
		part="$(trim "$part")"
		if [[ -n "$part" ]]; then
			cli_excludes+=("$part")
		fi
	done
}

load_file_excludes() {
	local line

	if ((use_exclude_file == 0)); then
		return
	fi

	if [[ ! -f "$exclude_file" ]]; then
		if ((exclude_file_explicit)); then
			die "exclude file does not exist: $exclude_file"
		fi
		return
	fi

	while IFS= read -r line || [[ -n "$line" ]]; do
		line="${line%%#*}"
		line="$(trim "$line")"
		if [[ -n "$line" ]]; then
			file_excludes+=("$line")
		fi
	done <"$exclude_file"
}

join_words() {
	local word
	local sep=""

	for word in "$@"; do
		printf '%s%s' "$sep" "$word"
		sep=" "
	done
}

read_flake_inputs() {
	local inputs_json
	local inputs_text

	if ! inputs_json="$(nix eval --impure --json --expr "builtins.attrNames (import $repo_dir/flake.nix).inputs")"; then
		die "failed to read flake inputs from $repo_dir/flake.nix"
	fi

	if ! inputs_text="$(jq -r '.[]' <<<"$inputs_json")"; then
		die "failed to parse flake inputs"
	fi

	mapfile -t all_inputs <<<"$inputs_text"
}

flake_update_log_has_retryable_warning() {
	local log_file="$1"

	grep -Eiq "$flake_update_retry_patterns" "$log_file"
}

cleanup_flake_update_log() {
	if [[ -n "${flake_update_log:-}" ]]; then
		rm -f "$flake_update_log"
	fi
}

run_flake_update_once() {
	local log_file="$1"
	local status

	: >"$log_file"

	set +e
	nix flake update \
		--flake "$flake_url" \
		"${update_inputs[@]}" 2>&1 | tee "$log_file"
	status="${PIPESTATUS[0]}"
	set -e

	return "$status"
}

while (($# > 0)); do
	case "$1" in
	switch | boot)
		if ((action_set)); then
			die "action specified more than once"
		fi
		action="$1"
		action_set=1
		shift
		;;
	-e | --exclude)
		(($# >= 2)) || die "--exclude requires a value"
		add_cli_excludes "$2"
		shift 2
		;;
	--exclude=*)
		add_cli_excludes "${1#--exclude=}"
		shift
		;;
	--exclude-file)
		(($# >= 2)) || die "--exclude-file requires a path"
		exclude_file="$2"
		exclude_file_explicit=1
		use_exclude_file=1
		shift 2
		;;
	--exclude-file=*)
		exclude_file="${1#--exclude-file=}"
		exclude_file_explicit=1
		use_exclude_file=1
		shift
		;;
	--no-exclude-file)
		use_exclude_file=0
		shift
		;;
	--list-inputs)
		list_inputs=1
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		die "unknown argument: $1"
		;;
	esac
done

command -v nix >/dev/null || die "nix is required"
command -v jq >/dev/null || die "jq is required"
command -v sns_until >/dev/null || die "sns_until is required"

if ((list_inputs == 0)); then
	echo "nix_update: repo: $repo_dir"
	echo "nix_update: action: $action"
fi

declare -a all_inputs=()
read_flake_inputs

if ((${#all_inputs[@]} == 0)); then
	die "flake.nix has no inputs"
fi

if ((list_inputs)); then
	printf '%s\n' "${all_inputs[@]}"
	exit 0
fi

load_file_excludes

declare -A known_inputs=()
declare -A excluded=()
declare -a update_inputs=()
declare -a excluded_inputs=()
declare -a unknown_excludes=()

for input in "${all_inputs[@]}"; do
	known_inputs["$input"]=1
done

for input in "${file_excludes[@]}" "${cli_excludes[@]}"; do
	excluded["$input"]=1
done

for input in "${!excluded[@]}"; do
	if [[ -z "${known_inputs[$input]+x}" ]]; then
		unknown_excludes+=("$input")
	fi
done

for input in "${unknown_excludes[@]}"; do
	echo "nix_update: warning: excluded input is not defined in flake.nix: $input" >&2
done

for input in "${all_inputs[@]}"; do
	if [[ -n "${excluded[$input]+x}" ]]; then
		excluded_inputs+=("$input")
	else
		update_inputs+=("$input")
	fi
done

if ((${#excluded_inputs[@]} > 0)); then
	echo "nix_update: excluding ${#excluded_inputs[@]} input(s): $(join_words "${excluded_inputs[@]}")"
fi

if ((${#update_inputs[@]} == 0)); then
	echo "nix_update: all flake inputs are excluded; skipping nix flake update"
	sns_until "$action"
	exit 0
fi

echo "nix_update: updating ${#update_inputs[@]} flake input(s)"

attempt=1
flake_update_log="$(mktemp "${TMPDIR:-/tmp}/nix_update_flake_update.XXXXXX.log")"
trap cleanup_flake_update_log EXIT

while true; do
	echo "nix_update: flake update attempt $attempt/$max_attempts"

	if run_flake_update_once "$flake_update_log"; then
		if ! flake_update_log_has_retryable_warning "$flake_update_log"; then
			break
		fi

		if ((attempt >= max_attempts)); then
			echo "nix_update: nix flake update still had retryable fetch warnings after $max_attempts attempts" >&2
			exit 1
		fi

		echo "nix_update: nix flake update exited successfully, but retryable fetch warnings were detected" >&2
	else
		if ((attempt >= max_attempts)); then
			echo "nix_update: nix flake update failed after $max_attempts attempts" >&2
			exit 1
		fi

		echo "nix_update: nix flake update failed" >&2
	fi

	attempt=$((attempt + 1))
	echo "nix_update: retrying flake update ($attempt/$max_attempts) in $retry_delay seconds" >&2
	sleep "$retry_delay"
	retry_delay=$((retry_delay * 2))
done

sns_until "$action"
